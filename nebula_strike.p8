pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- nebula strike
-- shmup vertical p/ pico-8
-- rafael + claude, 2026

function _init()
 cartdata("rafael_nebulastrike_v1")
 hi=dget(0)
 t,st,sel,shake,flash,lp,ecol=0,1,1,0,0,0,8
 stars,neb={},{}
 for i=1,45 do
  add(stars,{x=rnd(128),y=rnd(128),z=.2+rnd(.9)})
 end
 for i=1,7 do
  add(neb,{x=rnd(128),y=rnd(190),r=14+rnd(18),c=rnd{0x12,0x1d,0x2d}})
 end
 shipn=split"falcao,raio,tita"
 shipd=split("equilibrada|veloz, tiro duplo|lenta e blindada","|")
 -- vel,vida,cadencia,dano,poder
 shipst={split"1.5,3,6,1,1",split"2,2,5,.8,2",split"1.1,4,7,1.4,1"}
 statn=split"velocidade,blindagem,cadencia"
 snames=split"nebulosa de orion,cinturao de kepler,fortaleza vex"
 bnames=split"guardiao,colosso,nucleo"
 -- tipo,qtd,x (-1=aleatorio)
 waves=split("1,5,32/1,5,96/5,6,0/5,6,128/2,4,-1/1,8,64/3,2,-1/5,8,0/2,5,-1/1,6,40/1,6,88/4,1,64/5,6,128/5,6,0/3,3,-1/2,6,-1/1,8,32/1,8,96/3,2,-1/4,1,40/2,6,-1|6,4,-1/1,6,30/5,8,128/3,3,-1/6,5,-1/2,6,-1/4,1,40/4,1,88/5,8,0/6,6,-1/3,4,-1/2,8,-1/6,5,-1/1,8,96/5,8,128/3,4,-1/6,6,-1/4,2,-1/2,8,-1/6,8,-1/3,4,-1|5,8,0/5,8,128/3,4,-1/4,2,-1/2,8,-1/1,10,64/3,5,-1/4,3,-1/5,10,0/2,10,-1/3,6,-1/4,2,-1/5,10,128/1,10,32/1,10,96/3,6,-1/2,12,-1/4,3,-1/5,10,0/5,10,128/3,6,-1","|")
 ehp=split"2,3,7,34,1,9"
 epts=split"50,80,150,600,40,100"
 er=split"4,4,4,8,3,6"
 egap=split"14,22,40,60,9,30"
 esp=split"8,9,10,12,11"
 pcol=split"5,2,8,9,10,7"
 upn=split"blindagem,cadencia+,drone auxiliar,misseis,canhao+,escudo,ima,arsenal"
 updsc=split("+1 vida max e cura total|dispara mais rapido|nave extra que atira|misseis teleguiados|+50% de dano|bloqueia 1 golpe/fase|puxa itens de longe|+2 bombas","|")
 menuitem(1,"menu principal",go_title)
 go_title()
end

function _update60()
 t+=1
 local m=upd==upd_game and (st==3 and 2.4 or 1.3) or .7
 for s in all(stars) do
  s.y+=s.z*m
  if s.y>128 then s.y-=128 s.x=rnd(128) end
 end
 upd()
end

function _draw()
 camera(rnd(shake)-shake/2,rnd(shake)-shake/2)
 shake=shake>.5 and shake*.88 or 0
 drw()
 camera()
end

-- helpers de tela/menu
function scr(u,d)
 upd,drw,armed=u,d,false
end

function ok(b)
 if not (btn(4) or btn(5)) then armed=true end
 return armed and btnp(b)
end

function cprint(s,y,c,x)
 x=x or 64-print(s,0,-99)/2
 for i=-1,1 do
  for j=-1,1 do print(s,x+i,y+j,0) end
 end
 print(s,x,y,c)
end

function bigp(s,y,c)
 cprint("\^w\^t"..s,y,c)
end

function pad(n)
 local s=tostr(n,2)
 while #s<7 do s="0"..s end
 return s
end

function white()
 for i=1,15 do pal(i,7) end
end

function draw_stars()
 for s in all(stars) do
  local c=s.z>.8 and 7 or s.z>.5 and 6 or (st==2 and 4 or 5)
  if st==3 and upd==upd_game then
   line(s.x,s.y,s.x,s.y-s.z*4,c)
  else
   pset(s.x,s.y,c)
  end
 end
end

function save()
 newhi=score>hi
 if newhi then hi=score dset(0,hi) end
end

-- titulo
function go_title()
 st=1
 scr(upd_title,drw_title)
 music(0,0,3)
end

function upd_title()
 if ok(5) or ok(4) then sfx(9) scr(upd_sel,drw_sel) end
end

function drw_title()
 cls()
 draw_stars()
 bigp("nebula",20+sin(t/120)*2,12)
 bigp("strike",34+sin(t/120+.1)*2,8)
 cprint("um shmup de 3 fases",50,6)
 local x,y=60,68+sin(t/100)*3
 rectfill(x+3,y+8,x+4,y+9+rnd(3),rnd{8,9,10})
 spr(1+flr(t/90)%3,x,y)
 if t%40<26 then cprint("pressione ❎",90,7) end
 cprint("recorde "..pad(hi),102,9)
 cprint("rafael + claude 2026",120,5)
end

-- selecao de nave
function upd_sel()
 if btnp(0) then sel=(sel+1)%3+1 sfx(8) end
 if btnp(1) then sel=sel%3+1 sfx(8) end
 if ok(5) then sfx(9) new_game()
 elseif ok(4) then go_title() end
end

function drw_sel()
 cls()
 draw_stars()
 cprint("escolha sua nave",8,7)
 for i=1,3 do
  local x,s=i*40-28,i==sel
  rect(x-2,22,x+25,49,s and (t%20<10 and 10 or 9) or 5)
  sspr(i*8,0,8,8,x+4,27+(s and sin(t/60)*2 or 0),16,16)
 end
 local s=shipst[sel]
 cprint(shipn[sel],56,10)
 cprint(shipd[sel],65,6)
 local v={s[1]/2,s[2]/4,(8-s[3])/3}
 for j=1,3 do
  local y=70+j*8
  print(statn[j],16,y,6)
  rect(66,y,110,y+4,5)
  rectfill(67,y+1,67+42*v[j],y+3,11)
 end
 cprint("❎ atirar  🅾️ bomba",106,6)
 cprint("⬅️➡️ escolher  ❎ ok",117,5)
end

-- jogo
function new_game()
 local s=shipst[sel]
 pl={sp=sel,spd=s[1],hp=s[2],mhp=s[2],rate=s[3],dmg=s[4],pow=s[5],bombs=3,inv=0,cd=0,mc=0,opt=0,mis=0,shield=0,shmax=0,mag=0,o={{x=64,y=120},{x=64,y=120}}}
 score,lp,st=0,0,1
 start_stage()
end

function start_stage()
 pb,eb,en,parts,pick,txt={},{},{},{},{},{}
 boss=nil
 wv=split(waves[st],"/")
 wi,wn,wt,warn,clr,ts,dead,intro=0,0,90,0,0,0,0,160
 pl.x,pl.y,pl.shield,pl.inv=64,110,pl.shmax,60
 dif=1+lp*.3+(st-1)*.1
 hpm=1+lp*.6+(st-1)*.25
 scr(upd_game,drw_game)
 music(0,0,3)
end

function upd_game()
 ts+=1
 intro=max(intro-1)
 upd_player()
 upd_waves()
 if warn>0 then
  warn-=1
  if warn%45==0 then sfx(7) end
  if warn==0 then mk_boss() end
 end
 if boss then upd_boss() end
 -- tiros do jogador
 for b in all(pb) do
  if b.m then
   b.l-=1
   local tg=near(b)
   if tg then
    local a=atan2(tg.x-b.x,tg.y-b.y)
    b.dx+=cos(a)*.3 b.dy+=sin(a)*.3
   end
   local s=sqrt(b.dx*b.dx+b.dy*b.dy)/3
   if s>1 then b.dx/=s b.dy/=s end
   if ts%3==0 then add(parts,{x=b.x,y=b.y+2,dx=0,dy=.3,l=10,ml=10,r=1,c=5}) end
   if b.l<0 then del(pb,b) end
  end
  b.x+=b.dx b.y+=b.dy
  if b.y<-8 or b.y>136 or b.x<-8 or b.x>136 then
   del(pb,b)
  elseif bhit(b) then
   del(pb,b) spark(b.x,b.y)
  end
 end
 -- tiros inimigos
 for b in all(eb) do
  b.x+=b.dx b.y+=b.dy
  if b.x<-4 or b.x>132 or b.y<-4 or b.y>132 then
   del(eb,b)
  elseif dead==0 and pl.inv==0 and abs(b.x-pl.x)<2.5 and abs(b.y-pl.y)<2.5 then
   del(eb,b) hurt()
  end
 end
 for e in all(en) do upd_enemy(e) end
 for p in all(pick) do upd_pick(p) end
 for p in all(parts) do
  p.x+=p.dx p.y+=p.dy p.dx*=.9 p.dy*=.9 p.l-=1
  if p.l<=0 then del(parts,p) end
 end
 for x in all(txt) do
  x.y-=.3 x.l-=1
  if x.l<=0 then del(txt,x) end
 end
 if clr>0 then
  clr-=1
  if clr==0 then
   if st<3 then go_upg() else go_win() end
  end
 end
 if dead>0 then
  dead+=1
  if dead>150 then go_over() end
 end
end

function upd_player()
 if dead>0 then return end
 local p,dx,dy=pl,0,0
 if btn(0) then dx=-1 end
 if btn(1) then dx+=1 end
 if btn(2) then dy=-1 end
 if btn(3) then dy+=1 end
 if dx*dy!=0 then dx*=.7 dy*=.7 end
 p.x=mid(4,p.x+dx*p.spd,123)
 p.y=mid(12,p.y+dy*p.spd,122)
 p.inv=max(p.inv-1)
 p.cd-=1 p.mc-=1
 if btn(5) then
  if p.cd<=0 then p.cd=p.rate fire() end
  if p.mis>0 and p.mc<=0 then
   p.mc=44-p.mis*14
   pshot(p.x-5,p.y,-1.5,1) pshot(p.x+5,p.y,1.5,1)
  end
 end
 if btnp(4) and p.bombs>0 then bomb() end
 for i=1,2 do
  local o=p.o[i]
  o.x+=(p.x+(i*2-3)*12-o.x)*.2
  o.y+=(p.y+6-o.y)*.2
 end
end

function fire()
 local x,y,p=pl.x,pl.y-4,pl.pow
 if p!=2 and p!=3 then pshot(x,y,0) end
 if p>1 then pshot(x-3,y,0) pshot(x+3,y,0) end
 if p>2 then pshot(x-4,y+2,-.8) pshot(x+4,y+2,.8) end
 if p>4 then pshot(x-5,y+3,-1.6) pshot(x+5,y+3,1.6) end
 for i=1,pl.opt do
  local o=pl.o[i]
  pshot(o.x,o.y-3,0)
 end
 sfx(0,3)
end

function pshot(x,y,dx,m)
 add(pb,{x=x,y=y,dx=dx,dy=m and -2 or -6,d=m and pl.dmg*2 or pl.dmg,m=m,l=90})
end

function bhit(b)
 for e in all(en) do
  if abs(b.x-e.x)<e.r+2 and abs(b.y-e.y)<e.r+3 then
   hit(e,b.d)
   return true
  end
 end
 if boss and abs(b.x-boss.x)<16 and abs(b.y-boss.y)<11 then
  dmg_boss(b.d)
  return true
 end
end

function near(b)
 local best,bd=boss,999
 for e in all(en) do
  local d=abs(e.x-b.x)+abs(e.y-b.y)
  if d<bd then best,bd=e,d end
 end
 return best
end

function bomb()
 pl.bombs-=1
 flash,shake,eb=14,12,{}
 pl.inv=max(pl.inv,90)
 sfx(6)
 add(parts,{x=pl.x,y=pl.y,dx=0,dy=0,l=20,ml=20,r=50,ring=1})
 for e in all(en) do hit(e,12) end
 if boss then dmg_boss(25) end
end

function hurt()
 if pl.inv>0 or dead>0 then return end
 shake=6
 sfx(5)
 if pl.shield>0 then
  pl.shield-=1 pl.inv=60
  pop("escudo!",12)
  return
 end
 pl.hp-=1
 pl.pow=max(1,pl.pow-1)
 pl.inv=120 shake=10
 boom(pl.x,pl.y,1)
 for b in all(eb) do
  if abs(b.x-pl.x)+abs(b.y-pl.y)<40 then del(eb,b) end
 end
 if pl.hp<=0 then
  dead=1
  boom(pl.x,pl.y,3)
  music(-1)
 end
end

-- ondas
function upd_waves()
 if boss or warn>0 or clr>0 then return end
 wt-=1
 if wt>0 then return end
 if wn>0 then
  spawn(cw[1],cw[3])
  wn-=1
  wt=wn>0 and egap[cw[1]] or max(30,90-st*15-lp*10)
 elseif wi<#wv then
  wi+=1
  cw=split(wv[wi])
  wn=cw[2]
 elseif #en==0 then
  warn=180
  music(-1)
 end
end

function spawn(k,x,y)
 if x<0 then x=16+rnd(96) end
 local e={k=k,x=x,y=y or -8,ox=x,t=0,hp=ehp[k]*hpm,fl=0,r=er[k]}
 if k==3 then e.ty=20+rnd(30) end
 if k==5 then
  e.dx=x<64 and 1.3 or -1.3
  e.x=x<64 and -6 or 134
  e.y=10+rnd(20)
 end
 if k==6 then
  e.dx,e.dy,e.r=rnd(.6)-.3,.4+rnd(.4),5+rnd(3)
  e.hp*=e.r/6
 end
 add(en,e)
end

function upd_enemy(e)
 e.t+=1
 ecol=8
 local t,k=e.t,e.k
 if k==1 then
  e.y+=.55
  e.x=e.ox+sin(t/150)*18
  if t%100==50 then aim(e,1.2) end
 elseif k==2 then
  if t<45 then
   e.y+=1.1
  elseif t==45 then
   local a=atan2(pl.x-e.x,pl.y-e.y)
   e.dx,e.dy=cos(a)*2.3,sin(a)*2.3
   aim(e,1.4)
  else
   e.x+=e.dx e.y+=e.dy
  end
 elseif k==3 then
  if t<260 then e.y+=(e.ty-e.y)*.04 else e.y+=1 end
  if t>40 and t<250 and t%50==0 then
   fan(e.x,e.y+4,atan2(pl.x-e.x,pl.y-e.y),3,.07,1.3)
  end
 elseif k==4 then
  e.y+=.3
  if t%70==35 then ring(e.x,e.y,10,.9,t/300) end
 elseif k==5 then
  e.x+=e.dx e.y+=.4
  if t==40 then aim(e,1.3) end
 else
  e.x+=e.dx e.y+=e.dy
 end
 if e.y>140 or e.y<-40 or e.x<-20 or e.x>148 then
  del(en,e)
 elseif dead==0 and abs(e.x-pl.x)<e.r+2 and abs(e.y-pl.y)<e.r+2 then
  hurt() hit(e,4)
 end
end

function aim(e,s)
 if e.y<100 then eshot(e.x,e.y,atan2(pl.x-e.x,pl.y-e.y),s) end
end

function eshot(x,y,a,s)
 s*=dif
 add(eb,{x=x,y=y,dx=cos(a)*s,dy=sin(a)*s,c=ecol})
end

function fan(x,y,a,n,sp,s)
 for i=1,n do eshot(x,y,a+(i-(n+1)/2)*sp,s) end
end

function ring(x,y,n,s,o)
 for i=1,n do eshot(x,y,o+i/n,s) end
end

function hit(e,d)
 e.hp-=d e.fl=3
 if e.hp<=0 then kill(e) elseif ts%3==0 then sfx(1) end
end

function kill(e)
 del(en,e)
 local k,r=e.k,rnd()
 boom(e.x,e.y,k==4 and 2 or 1)
 addscore(epts[k]*(lp+1),e.x,e.y)
 if k==4 or k==3 and r<.35 or r<.04 then
  drop(e.x,e.y,1)
 elseif r<.07 then
  drop(e.x,e.y,rnd{2,3})
 end
 if k==4 and r<.5 then drop(e.x+6,e.y,2) end
 for i=1,k==4 and 6 or k>5 and 3 or 1 do
  drop(e.x+rnd(8)-4,e.y+rnd(8)-4,4)
 end
end

-- efeitos
function boom(x,y,s)
 sfx(s>1 and 3 or 2)
 shake=max(shake,s*3)
 add(parts,{x=x,y=y,dx=0,dy=0,l=8+s*4,ml=8+s*4,r=s*6,ring=1})
 for i=1,s*8 do
  local a,v,l=rnd(),rnd(s*1.2)+.3,10+rnd(10*s)
  add(parts,{x=x,y=y,dx=cos(a)*v,dy=sin(a)*v,l=l,ml=l,r=rnd(s*2)+1})
 end
end

function spark(x,y)
 for i=1,2 do
  add(parts,{x=x,y=y,dx=rnd(2)-1,dy=rnd(2)-1.5,l=6,ml=6,r=0,c=10})
 end
end

function pop(s,c,x,y)
 add(txt,{x=x or pl.x-#s*2,y=y or pl.y-10,s=s,l=40,c=c})
end

function addscore(n,x,y)
 score+=n>>16
 if x and n>=100 then pop(""..n,10,x-6,y) end
end

-- itens
function drop(x,y,k)
 add(pick,{x=x,y=y,k=k,dy=-1})
end

function upd_pick(p)
 p.dy=min(p.dy+.04,.5)
 p.y+=p.dy
 local dx,dy=pl.x-p.x,pl.y-p.y
 local d=abs(dx)+abs(dy)
 if dead==0 then
  if d<8 then collect(p) del(pick,p) return end
  if d<(pl.mag>0 and 90 or p.k==4 and 30 or 14) then
   p.x+=dx/d*3 p.y+=dy/d*3
  end
 end
 if p.y>134 then del(pick,p) end
end

function collect(p)
 local k=p.k
 if k==4 then addscore(10) sfx(11) return end
 sfx(4)
 if k==1 then
  if pl.pow<5 then
   pl.pow+=1 pop("power up!",11) sfx(10)
  else
   addscore(1000,p.x,p.y)
  end
 elseif k==2 then
  pl.bombs=min(pl.bombs+1,6) pop("+bomba",9)
 else
  pl.hp=min(pl.hp+1,pl.mhp) pop("+vida",8)
 end
end

-- chefes
function mk_boss()
 local h=({150,230,320})[st]*(1+lp*.6)
 boss={x=64,y=-24,hp=h,mx=h,a=0,fl=0}
 music(8,0,3)
end

function upd_boss()
 local b=boss
 b.fl=max(b.fl-1)
 if b.dt then
  b.dt+=1
  if b.dt%6==0 then boom(b.x+rnd(36)-18,b.y+rnd(20)-10,rnd()<.3 and 2 or 1) end
  if b.dt>110 then
   boom(b.x,b.y,3) boom(b.x-12,b.y+4,2) boom(b.x+12,b.y-4,2)
   flash,boss,clr=12,nil,170
   for i=1,st*(lp+1) do addscore(5000) end
   sfx(12)
  end
  return
 end
 if b.y<26 then b.y+=.4 return end
 b.a+=1
 local a=b.a
 b.x=64+sin(a/500)*36
 b.y=26+sin(a/210)*5
 local x,y,ph,am=b.x,b.y,b.hp<b.mx/2,atan2(pl.x-b.x,pl.y-b.y)
 ecol=14
 if st==1 then
  if a%50==0 then fan(x,y+10,am,ph and 7 or 5,.06,1.3) end
  if a%120==60 then fan(x-14,y+6,.75,3,.1,1.6) fan(x+14,y+6,.75,3,.1,1.6) end
  if ph and a%9==0 then eshot(x,y,a/80,1) eshot(x,y,a/80+.5,1) end
 elseif st==2 then
  if a%70==0 then ring(x,y,ph and 18 or 12,.9,a/200) end
  if a%160==80 then spawn(1,16) spawn(1,112) end
  if ph and a%50<15 and a%3==0 then eshot(x,y+8,am,2.2) end
 else
  if a%(ph and 5 or 8)==0 then eshot(x,y,a/100,1.2) eshot(x,y,a/100+.5,1.2) end
  if a%70==0 then fan(x,y+8,am,ph and 7 or 5,.05,1.6) end
  if ph and a%110==55 then ring(x,y,20,.8,0) end
 end
 if dead==0 and pl.inv==0 and abs(pl.x-x)<14 and abs(pl.y-y)<10 then hurt() end
end

function dmg_boss(d)
 local b=boss
 if b.y<26 or b.dt then return end
 b.hp-=d b.fl=2
 if ts%4==0 then sfx(1) end
 if b.hp<=0 then
  b.dt,eb,pl.inv=0,{},240
  music(-1) sfx(3)
  for e in all(en) do kill(e) end
 end
end

-- desenho do jogo
function draw_bg()
 cls(({1,0,0})[st])
 if st==1 then
  fillp(0x5a5a)
  for n in all(neb) do
   circfill(n.x,(n.y+ts*.15)%190-30,n.r,n.c)
  end
  fillp()
 elseif st==2 then
  local y=ts*.06%280-30
  circfill(98,y,34,2)
  circfill(92,y-5,30,4)
  fillp(0x5a5a)
  circfill(86,y-10,20,0x94)
  fillp()
  oval(48,y-5,148,y+5,9)
 else
  local s=ts*1.2
  for i=-1,8 do
   local y,k=i*16+s%16,i-flr(s/16)
   local w,c=6+k*7%4*4,t%30<15 and 8 or 2
   line(0,y,127,y,1)
   rectfill(0,y,w,y+15,5) rectfill(127-w,y,127,y+15,5)
   line(w,y,w,y+15,6) line(127-w,y,127-w,y+15,6)
   pset(w-3,y+8,c) pset(130-w,y+8,c)
  end
 end
end

function draw_en(e)
 if e.fl>0 then e.fl-=1 white() end
 local x,y,k=e.x,e.y,e.k
 if k==4 then
  spr(12,x-8,y-8,2,2)
 elseif k==6 then
  circfill(x,y,e.r,2) circfill(x-1,y-1,e.r-1,4)
  circfill(x+2,y+1,1,2) pset(x-2,y-2,9)
 else
  spr(esp[k],x-4,y-4)
 end
 pal()
end

function draw_boss()
 local b,s=boss,({64,66,68})[st]
 if b.fl>0 or b.dt and t%4<2 then white() end
 if st==3 then pal(14,({14,8,2,8})[flr(t/6)%4+1]) end
 spr(s,b.x-16,b.y-12,2,3)
 spr(s,b.x,b.y-12,2,3,true)
 pal()
end

function draw_player()
 if dead>0 then return end
 local x,y=pl.x,pl.y
 for i=1,pl.opt do
  local o=pl.o[i]
  spr(6,o.x-4,o.y-4)
 end
 if pl.inv>0 and t%6<3 then return end
 rectfill(x-1,y+4,x,y+5+rnd(3),rnd{8,9,10})
 spr(pl.sp,x-4,y-4)
 if pl.shield>0 then circ(x,y,7,t%12<6 and 12 or 13) end
end

function hud()
 rectfill(0,0,127,6,0)
 line(0,7,127,7,1)
 print(pad(score),1,1,7)
 for i=1,pl.mhp do
  if i>pl.hp then pal(8,5) pal(7,5) end
  spr(5,28+i*6,1)
 end
 pal()
 for i=1,pl.shield do circ(31+(pl.mhp+i)*6,3,2,12) end
 for i=1,pl.bombs do spr(14,84+i*5,1) end
 print("p"..pl.pow,120,1,pl.pow==5 and 10 or 12)
 if boss and not boss.dt and boss.y>0 then
  rectfill(14,10,113,13,0) rect(14,10,113,13,5)
  rectfill(15,11,15+97*boss.hp/boss.mx,12,boss.hp<boss.mx/2 and 8 or 14)
  print(bnames[st],15,16,5)
 end
end

function drw_game()
 draw_bg()
 draw_stars()
 for p in all(pick) do
  if p.k==4 then
   circ(p.x,p.y,1,t%8<4 and 12 or 11) pset(p.x,p.y,7)
  else
   local c=({12,9,8})[p.k]
   circfill(p.x,p.y,4,c)
   circ(p.x,p.y,4,t%16<8 and 7 or c)
   print(sub("pbh",p.k,p.k),p.x-1,p.y-2,7)
  end
 end
 for e in all(en) do draw_en(e) end
 if boss then draw_boss() end
 for b in all(pb) do
  if b.m then spr(7,b.x-3,b.y-3) else spr(4,b.x-4,b.y-4) end
 end
 draw_player()
 for p in all(parts) do
  local f=p.l/p.ml
  if p.ring then
   circ(p.x,p.y,p.r*(1-f)+2,f>.5 and 7 or 9)
  elseif p.c then
   circfill(p.x,p.y,p.r,p.c)
  else
   circfill(p.x,p.y,p.r*f+.5,pcol[ceil(f*6)])
  end
 end
 for b in all(eb) do
  circfill(b.x,b.y,2,b.c) circfill(b.x,b.y,1,7)
 end
 for x in all(txt) do print(x.s,x.x,x.y,x.l%6<3 and 7 or x.c) end
 camera()
 hud()
 if intro>0 and intro<150 then
  rectfill(0,52,127,74,0)
  line(0,52,127,52,12) line(0,74,127,74,12)
  cprint("fase "..st..(lp>0 and " - loop "..lp+1 or ""),56,12)
  cprint(snames[st],66,7)
 end
 if warn>0 and warn%30<20 then
  rectfill(0,54,127,74,2)
  cprint("!! alerta !!",57,8)
  cprint("chefe: "..bnames[st],66,7)
 end
 if clr>0 and clr<150 then
  cprint("fase concluida!",50,10)
  cprint("bonus "..st*(lp+1).." x 5000",60,7)
 end
 if flash>0 then
  flash-=1
  if flash<6 then fillp(0x5a5a.8) end
  rectfill(0,0,127,127,7)
  fillp()
 end
end

-- upgrades entre fases
function go_upg()
 local pool={}
 for i=1,8 do
  if not (i==1 and pl.mhp>=6 or i==2 and pl.rate<=3 or i==3 and pl.opt>=2 or i==4 and pl.mis>=2 or i==6 and pl.shmax>=2 or i==7 and pl.mag>0) then
   add(pool,i)
  end
 end
 opts,us={},1
 for i=1,3 do
  local c=rnd(pool)
  add(opts,c) del(pool,c)
 end
 scr(upd_upg,drw_upg)
end

function upd_upg()
 if btnp(2) then us=(us+1)%3+1 sfx(8) end
 if btnp(3) then us=us%3+1 sfx(8) end
 if ok(5) then
  local u=opts[us]
  if u==1 then pl.mhp+=1 pl.hp=pl.mhp
  elseif u==2 then pl.rate-=1
  elseif u==3 then pl.opt+=1
  elseif u==4 then pl.mis+=1
  elseif u==5 then pl.dmg*=1.5
  elseif u==6 then pl.shmax+=1
  elseif u==7 then pl.mag=1
  else pl.bombs=min(pl.bombs+2,6) end
  sfx(10)
  st+=1
  pl.hp=min(pl.hp+1,pl.mhp)
  start_stage()
 end
end

function drw_upg()
 cls()
 draw_stars()
 cprint("fase "..st.." concluida",6,11)
 cprint("escolha um upgrade",16,10)
 for i=1,3 do
  local y,u,s=i*26+2,opts[i],i==us
  rectfill(8,y,119,y+20,s and 1 or 0)
  rect(8,y,119,y+20,s and (t%20<10 and 10 or 9) or 5)
  print(upn[u],14,y+4,s and 7 or 6)
  print(updsc[u],14,y+12,s and 12 or 5)
 end
 print("vida "..pl.hp.."/"..pl.mhp.."  drones "..pl.opt.."  misseis "..pl.mis,6,108,6)
 cprint("⬆️⬇️ escolher  ❎ ok",118,5)
end

-- fim de jogo
function go_over()
 save()
 sfx(13)
 scr(upd_over,drw_over)
end

function upd_over()
 if ok(5) then new_game() elseif ok(4) then go_title() end
end

function drw_over()
 cls()
 draw_stars()
 bigp("game over",30,8)
 cprint("fase "..st.." - "..snames[st],52,6)
 cprint("pontos "..pad(score),64,9)
 if newhi and t%30<20 then cprint("novo recorde!",74,11) end
 cprint("❎ tentar de novo",96,7)
 cprint("🅾️ menu",106,6)
end

function go_win()
 save()
 scr(upd_win,drw_win)
 music(0,0,3)
end

function upd_win()
 if ok(5) then
  lp+=1 st=1 pl.hp=pl.mhp
  start_stage()
 elseif ok(4) then
  go_title()
 end
end

function drw_win()
 cls()
 draw_stars()
 bigp("vitoria!",26,10)
 cprint("a frota vex foi destruida",48,7)
 cprint("pontos "..pad(score),62,9)
 if newhi and t%30<20 then cprint("novo recorde!",72,11) end
 cprint("❎ loop "..(lp+2).." (mais dificil)",96,7)
 cprint("🅾️ menu",106,6)
end
